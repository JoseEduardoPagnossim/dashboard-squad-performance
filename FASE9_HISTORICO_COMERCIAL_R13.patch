+  // Fase 9: visualizacao somente leitura dos lotes comerciais existentes no Supabase.
+  // A consulta nunca recalcula comissoes, altera vendas ou altera snapshots.
+  const strategyCommercialHistory={busy:false,rows:[],sales:[],selected:null,truncated:false};
+  const strategyCommercialSourceLabel=key=>key==='contracted_modules_csv'?'MRR':key==='merchandise_sales_csv'?'Mercadorias':'Outra';
+  function strategyCommercialHistoryRows(){const source=$('#strategyCommercialHistorySource')?.value||'';return strategyCommercialHistory.rows.filter(x=>!source||x.source_key===source);}
+  function renderStrategyCommercialHistory(){
+    const body=$('#strategyCommercialHistoryRows');if(!body)return;
+    const rows=strategyCommercialHistoryRows();
+    body.innerHTML=rows.map(r=>`<tr><td>${escapeHtml(new Date(r.created_at).toLocaleString('pt-BR'))}</td><td>${escapeHtml(strategyCommercialSourceLabel(r.source_key))}</td><td>${escapeHtml(r.file_name||'—')}</td><td>${escapeHtml(r.status||'—')}</td><td>${fmtInt(r.total_rows)}</td><td>${fmtInt(r.imported)}</td><td>${fmtInt(r.duplicates)}</td><td>${fmtInt(r.closed)}</td><td><button class="btn secondary" type="button" data-strategy-commercial-batch="${escapeHtml(r.id)}">Ver vendas</button></td></tr>`).join('')||'<tr><td colspan="9">Nenhum lote comercial encontrado.</td></tr>';
+  }
+  async function refreshStrategyCommercialHistory(){
+    if(strategyCommercialHistory.busy)return;
+    if(!state.supabase||!strategyEditAccess()||!strategyPeopleAccess())return toast('A auditoria exige acesso financeiro e conexão com o Supabase.');
+    const status=$('#strategyCommercialHistoryStatus'),org=state.user?.organizationId;if(!org)return;
+    strategyCommercialHistory.busy=true;if(status)status.textContent='Buscando lotes comerciais...';
+    try{
+      const sources=await state.supabase.from('strategy_import_sources').select('id,source_key').eq('organization_id',org).in('source_key',['contracted_modules_csv','merchandise_sales_csv']);
+      if(sources.error)throw sources.error;
+      const keys=new Map((sources.data||[]).map(x=>[x.id,x.source_key]));
+      let rows=[];
+      if(keys.size){const q=await state.supabase.from('strategy_import_batches').select('id,source_id,file_name,status,total_rows,accepted_rows,rejected_rows,created_at').eq('organization_id',org).in('source_id',[...keys.keys()]).order('created_at',{ascending:false}).limit(50);if(q.error)throw q.error;rows=q.data||[];}
+      const result=await Promise.all(rows.map(async r=>{
+        const source_key=keys.get(r.source_id);
+        const table=source_key==='contracted_modules_csv'?'strategy_recurring_import_attempts':'strategy_merchandise_import_attempts';
+        // Agrupamento no cliente com limite defensivo; pagina ate 5000 tentativas.
+        const counts={imported:0,duplicates:0,closed:0};let truncated=false;
+        for(let start=0;start<5000;start+=500){const q=await state.supabase.from(table).select('outcome').eq('organization_id',org).eq('batch_id',r.id).range(start,start+499);if(q.error)throw q.error;for(const x of q.data||[])if(x.outcome==='imported')counts.imported++;else if(x.outcome==='duplicate')counts.duplicates++;else if(x.outcome==='closed')counts.closed++;if((q.data||[]).length<500)break;if(start===4500)truncated=true;}
+        return {...r,source_key,...counts,truncated};
+      }));
+      strategyCommercialHistory.rows=result;strategyCommercialHistory.selected=null;strategyCommercialHistory.sales=[];
+      if($('#strategyCommercialHistoryDetails'))$('#strategyCommercialHistoryDetails').hidden=true;
+      if(status)status.textContent=`${result.length} lote(s) recente(s). ${result.some(r=>r.truncated)?'Há lotes com mais de 5.000 tentativas: contagens parciais. ':''}Lotes em rascunho podem estar incompletos. Os dados vêm do Supabase.`;
+      renderStrategyCommercialHistory();
+    }catch(err){console.error(err);if(status)status.textContent='Não foi possível consultar o histórico: '+String(err?.message||err);}
+    finally{strategyCommercialHistory.busy=false;}
+  }
+  async function openStrategyCommercialHistoryBatch(id){
+    if(strategyCommercialHistory.busy||!state.supabase||!strategyEditAccess()||!strategyPeopleAccess())return;
+    const batch=strategyCommercialHistory.rows.find(r=>r.id===id);if(!batch)return;
+    const status=$('#strategyCommercialHistoryDetailStatus'),org=state.user?.organizationId;
+    strategyCommercialHistory.busy=true;if(status)status.textContent='Carregando vendas do lote...';
+    try{
+      const table=batch.source_key==='contracted_modules_csv'?'strategy_recurring_sales':'strategy_merchandise_sales';
+      const rows=[];let truncated=false;
+      for(let start=0;start<5000;start+=500){const q=await state.supabase.from(table).select(batch.source_key==='contracted_modules_csv'?'id,occurred_on,seller_name,squad_code,product_id,customer_name,monthly_amount,active_monthly_amount,commission_rule_at_import,source_occurrence':'id,occurred_on,seller_name,squad_code,product_id,customer_name,gross_amount,commission_rule_at_import,source_occurrence').eq('organization_id',org).eq('batch_id',id).order('occurred_on').range(start,start+499);if(q.error)throw q.error;rows.push(...(q.data||[]));if((q.data||[]).length<500)break;if(start===4500)truncated=true;}
+      const products=await state.supabase.from('strategy_commercial_products').select('id,name').eq('organization_id',org);if(products.error)throw products.error;
+      const names=new Map((products.data||[]).map(p=>[p.id,p.name]));
+      const sales=rows.map(x=>{const amount=Number(batch.source_key==='contracted_modules_csv'?x.monthly_amount:x.gross_amount);const estimate=strategyAuditEstimate({amount,rule:x.commission_rule_at_import});return {...x,amount,estimate,productName:names.get(x.product_id)||'Produto não localizado'};});
+      strategyCommercialHistory.selected=batch;strategyCommercialHistory.sales=sales;strategyCommercialHistory.truncated=truncated;
+      const section=$('#strategyCommercialHistoryDetails');if(section)section.hidden=false;
+      if(status)status.textContent=`Lote ${id} · ${sales.length} venda(s) gravada(s) ${truncated?'(PARCIAL: limite de 5.000 registros)':''} · ${batch.duplicates} tentativa(s) duplicada(s) · ${batch.closed} competência(s) fechada(s). Tentativas recusadas não aparecem como vendas.`;
+      const body=$('#strategyCommercialHistorySales');if(body)body.innerHTML=sales.slice(0,200).map(x=>`<tr><td>${escapeHtml(x.occurred_on||'')}</td><td>${escapeHtml(x.seller_name||'')}</td><td>${escapeHtml(x.squad_code||'')}</td><td>${escapeHtml(x.productName)}</td><td>${escapeHtml(x.customer_name||'')}</td><td>${fmtMoney(x.amount)}</td><td>${batch.source_key==='contracted_modules_csv'?(x.active_monthly_amount==null?'—':fmtMoney(x.active_monthly_amount)):'—'}</td><td>${x.estimate==null?'Regra não reconhecida':fmtMoney(x.estimate)}</td><td>${fmtInt(x.source_occurrence)}</td></tr>`).join('')||'<tr><td colspan="9">Nenhuma venda gravada neste lote.</td></tr>';
+    }catch(err){console.error(err);if(status)status.textContent='Erro ao consultar vendas: '+String(err?.message||err);}
+    finally{strategyCommercialHistory.busy=false;}
+  }
+  function exportStrategyCommercialHistory(kind){
+    if(kind==='sales'){
+      const b=strategyCommercialHistory.selected;if(!b)return toast('Selecione primeiro um lote.');
