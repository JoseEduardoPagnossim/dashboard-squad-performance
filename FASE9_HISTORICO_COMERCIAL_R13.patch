+      return strategyAuditDownload('vendas-lote-'+b.id+'.csv',['ID','Data','Vendedor','Squad','Produto','Cliente','Valor','MRR ativo','Comissão estimada','Ocorrência','Lote'],strategyCommercialHistory.sales.map(x=>[x.id,x.occurred_on,x.seller_name,x.squad_code,x.productName,x.customer_name,x.amount,x.active_monthly_amount??'',x.estimate??'',x.source_occurrence,b.id]));
+    }
+    return strategyAuditDownload('historico-importacoes-comerciais.csv',['Lote','Data','Origem','Arquivo','Status','Total CSV','Importadas','Duplicadas','Fechadas','Contagem parcial'],strategyCommercialHistoryRows().map(x=>[x.id,x.created_at,x.source_key,x.file_name,x.status,x.total_rows,x.imported,x.duplicates,x.closed,x.truncated?'SIM':'NAO']));
+  }
